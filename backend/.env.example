# Copie para backend/.env e inicie o Java dentro de backend/. Também aceita variáveis de ambiente.
RESEND_API_KEY=
RESEND_FROM=
APP_FRONTEND_URL=http://localhost:5173
APP_DEFAULT_TENANT_ID=1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Gere uma chave aleatória com pelo menos 32 bytes para manter sessões entre reinicializações.
JWT_SECRET=
# OAuth é habilitado apenas para provedores configurados. Use o mesmo host nos serviços.
APP_API_URL=http://localhost:8080
AUTH_SECURE_COOKIES=false
JWT_EXPIRATION_MINUTES=30
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
