# Copie para .env.production somente no cofre de segredos ou servidor de produção.
# Nunca versione o arquivo preenchido.
SPRING_PROFILES_ACTIVE=production
DB_HOST=postgres
DB_PORT=5432
DB_NAME=clinisis
DB_USER=clinisis_app
DB_PASSWORD=SUBSTITUA_POR_UMA_SENHA_LONGA_E_ALEATORIA
DB_POOL_MAX_SIZE=10

# Pelo menos 32 caracteres aleatórios. Não reutilize a senha do banco.
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_DE_NO_MINIMO_32_CARACTERES
JWT_EXPIRATION_MINUTES=30


APP_DOMAIN=app.exemplo.com.br
ACME_EMAIL=infra@exemplo.com.br
APP_FRONTEND_URL=https://app.exemplo.com.br
APP_API_URL=https://app.exemplo.com.br
CORS_ALLOWED_ORIGINS=https://app.exemplo.com.br
AUTH_SECURE_COOKIES=true

# Resend — necessário para magic links.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_FROM=Clinisis <acesso@exemplo.com.br>

# Opcional: configure os dois valores de cada provedor juntos.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Base64 de exatamente 32 bytes, gerada e guardada no cofre de segredos.
IMPORT_FILE_ENCRYPTION_KEY=
EXPORT_ENCRYPTION_KEY=

# URL de conexão do Chatbot. Use senha codificada para URL (URL encoding).
CHATBOT_DATABASE_URL=postgresql+psycopg://clinisis_app:SENHA_CODIFICADA@postgres:5432/clinisis
