# Copie para .env.production somente no cofre de segredos ou servidor de produção.
# Nunca versione o arquivo preenchido.
SPRING_PROFILES_ACTIVE=production
APP_VERSION=2026.10.25-1
ACME_EMAIL=operacao@exemplo.com.br
DB_ADMIN_PASSWORD=SUBSTITUA_POR_SEGREDO_EXCLUSIVO_DO_POSTGRES
DB_HOST=postgres
DB_PORT=5432
DB_NAME=clinisis
DB_USER=clinisis_app
DB_PASSWORD=SUBSTITUA_POR_UMA_SENHA_LONGA_E_ALEATORIA
DB_POOL_MAX_SIZE=10

# Pelo menos 32 caracteres aleatórios. Não reutilize a senha do banco.
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_DE_NO_MINIMO_32_CARACTERES
JWT_EXPIRATION_MINUTES=30

APP_FRONTEND_URL=https://app.exemplo.com.br
APP_API_URL=https://api.exemplo.com.br
CORS_ALLOWED_ORIGINS=https://app.exemplo.com.br
AUTH_SECURE_COOKIES=true

# Resend — necessário para magic links.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_FROM=Clinisis <acesso@exemplo.com.br>

# Opcional: configure os dois valores de cada provedor juntos.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Base64 de exatamente 32 bytes, gerada e guardada no cofre de segredos.
IMPORT_FILE_ENCRYPTION_KEY=
EXPORT_ENCRYPTION_KEY=

# Chave clínica independente das chaves de importação e exportação.
DATA_ENCRYPTION_KEY_VERSION=v1
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_PREVIOUS_KEYS=
DATA_ENCRYPTION_ALLOW_LEGACY_READ=false

# Somente para leitura de prontuários criados pelo formato lateral da migração 031.
DATA_ENCRYPTION_LEGACY_ACTIVE_VERSION=1
DATA_ENCRYPTION_KEYS=

# Chatbot: gere uma chave independente e configure as credenciais da Meta no cofre.
WHATSAPP_CREDENTIAL_ENCRYPTION_KEY=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
ID_CLINICA=1
