# Conexao com o banco ja existente do sistema (schema em database/schema_clinica.sql)
DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/clinica

# URL base da API REST do sistema Java, para consumo futuro pelo chatbot
SISTEMA_API_URL=

# ---------------------------------------------------------------------
# WhatsApp Business Cloud API (Meta) — API oficial
# Onde achar cada valor: developers.facebook.com > seu app > WhatsApp >
# "Configuracao da API" (Phone number ID e token) e Configuracoes > Basico
# (App Secret).
# ---------------------------------------------------------------------
WHATSAPP_API_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v23.0

# ID do numero remetente (NAO e o numero de telefone, e o "Phone number ID")
WHATSAPP_PHONE_NUMBER_ID=

# Token de acesso. O token temporario do painel expira em 24h — para valer
# de verdade, gere um token permanente de System User.
WHATSAPP_API_TOKEN=

# Senha inventada por voce; repita exatamente a mesma no campo "Verificar
# token" ao cadastrar a URL de callback do webhook no painel da Meta.
WHATSAPP_VERIFY_TOKEN=

# App Secret — usado para validar a assinatura dos webhooks recebidos.
WHATSAPP_APP_SECRET=
